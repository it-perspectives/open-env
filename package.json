{
  "name": "@it-perspectives/openenv",
  "version": "0.1.0",
  "description": "OpenENV environment variable contracts, JSON Schema, and linter",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "website"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/it-perspectives/OpenENV.git"
  },
  "bin": {
    "openenv": "bin/openenv.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./schema": "./schemas/openenv-0.1.0.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "examples",
    "docs",
    "SPEC.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "site:build": "npm run build --workspace @openenv/website",
    "site:dev": "npm run dev --workspace @openenv/website",
    "site:check": "npm run check --workspace @openenv/website",
    "site:preview": "npm run preview --workspace @openenv/website",
    "vscode:build": "node scripts/build-vscode.js",
    "vscode:package": "npm run vscode:build && node scripts/package-vscode.js",
    "previews:verify": "npm run site:build && npm run vscode:build && node scripts/verify-previews.js",
    "lint": "node bin/openenv.js lint examples/openenv.yaml examples/openenv.json --warnings-as-errors",
    "verify": "npm test && npm run lint",
    "release:prepare": "npm run verify && node scripts/prepare-release.js",
    "deploy": "node scripts/deploy.js",
    "prepack": "npm run verify",
    "vscode:deploy": "node scripts/deploy-vscode.js",
    "vscode:test": "node scripts/run-vscode-tests.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "ovsx": "1.2.0"
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    }
  }
}
