    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "astro": "7.3.8",
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1"
