{
  "name": "@openenv/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "prepare:assets": "node ../scripts/prepare-site.js",
    "predev": "npm run prepare:assets",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
