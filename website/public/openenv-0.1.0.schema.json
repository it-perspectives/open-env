{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/it-perspectives/OpenENV/v0.1.0/schemas/openenv-0.1.0.schema.json",
  "title": "OpenENV 0.1.0 environment variable contract",
  "type": "object",
  "required": [
    "openenv",
    "info",
    "variables"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": {}
  },
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/it-perspectives/OpenENV/v0.1.0/schemas/openenv-0.1.0.schema.json",
      "description": "Versioned editor schema URL. The validator never downloads remote schemas."
    },
    "openenv": {
      "const": "0.1.0",
      "description": "Supported OpenENV specification version."
    },
    "info": {
      "type": "object",
      "required": [
        "title",
        "version"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": {}
      },
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty application title."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Application contract version, independent of the specification version."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description."
        }
      },
      "description": "Application contract metadata."
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/variable"
      },
      "description": "Map from environment variable names to their definitions."
    }
  },
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "variable": {
      "type": "object",
      "required": [
        "description",
        "type"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": {}
      },
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description."
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array"
          ],
          "description": "Value type used to decode the environment string."
        },
        "delimiter": {
          "description": "Required for array variables: a single space or comma.",
          "enum": [
            " ",
            ","
          ]
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the environment variable must be present when no default exists."
        },
        "sensitive": {
          "type": "boolean",
          "default": false,
          "description": "Marks a secret. Defaults, examples and enums are forbidden."
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "Marks a variable that consumers should stop using."
        },
        "default": {
          "$ref": "#/$defs/value",
          "description": "Value used when the environment variable is absent."
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          },
          "description": "Non-empty list of values satisfying the variable constraints."
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/value"
          },
          "description": "Allowed complete values; each must satisfy the variable constraints."
        },
        "format": {
          "enum": [
            "uri",
            "uri-reference",
            "email",
            "hostname",
            "ipv4",
            "ipv6"
          ],
          "description": "Standard string format."
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression applied to string values."
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum string length, independent of requiredness."
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum string length."
        },
        "minimum": {
          "type": "number",
          "description": "Minimum numeric value."
        },
        "maximum": {
          "type": "number",
          "description": "Maximum numeric value."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "properties": {
              "delimiter": {}
            },
            "required": [
              "delimiter"
            ]
          },
          "else": {
            "properties": {
              "delimiter": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "else": {
            "properties": {
              "format": false,
              "pattern": false,
              "minLength": false,
              "maxLength": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "integer",
                  "number"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "minimum": false,
              "maximum": false
            }
          }
        },
        {
          "if": {
            "required": [
              "sensitive"
            ],
            "properties": {
              "sensitive": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "default": false,
              "examples": false,
              "enum": false
            }
          }
        }
      ]
    }
  }
}
